# Copy to ".env" (Windows: copy .env.example .env) and edit. NEVER commit ".env".

# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

MYSQL_DATABASE=acoustic_epidemiology
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Comma-separated list of frontend origins (must match your Vite dev URL exactly)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional settings
MAX_AUDIO_UPLOAD_MB=25
AUTH_THROTTLE_RATE=10/min
# Path to a trained model file. Leave empty: no model is configured, so no predictions are made.
ML_MODEL_PATH=
